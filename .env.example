# ─────────────────────────────────────────────
# Naver Search Ads (Keyword) API
# https://searchad.naver.com → 도구 > API 사용 신청
# ─────────────────────────────────────────────
NAVER_API_KEY=your_naver_api_key
NAVER_SECRET_KEY=your_naver_secret_key
NAVER_CUSTOMER_ID=your_naver_customer_id

# ─────────────────────────────────────────────
# Google AI (Gemini) API  (텍스트 생성 + 이미지 생성 통합)
# https://aistudio.google.com/apikey
# ─────────────────────────────────────────────
GOOGLE_AI_API_KEY=your_google_ai_api_key

# ─────────────────────────────────────────────
# Tavily Search API  (최신 데이터 수집 · 할루시네이션 최소화)
# https://app.tavily.com
# ─────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key

# ─────────────────────────────────────────────
# 출력 디렉터리 (기본값: ./output)
# ─────────────────────────────────────────────
OUTPUT_DIR=output
